.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #1a1a2e;
  padding: 0 2rem;
  height: 60px;
  border-bottom: 2px solid #16213e;
  position: sticky;
  top: 0;
  z-index: 100;
}

.navbar-brand {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  text-decoration: none;
}

.navbar-logo {
  color: #4ade80;
  font-size: 1rem;
}

.navbar-title {
  color: #e2e8f0;
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: 0.5px;
}

.navbar-links {
  display: flex;
  gap: 1.5rem;
}

.navbar-links a {
  color: #94a3b8;
  text-decoration: none;
  font-size: 0.95rem;
  padding: 0.4rem 0.8rem;
  border-radius: 4px;
  transition: color 0.2s, background 0.2s;
}

.navbar-links a:hover {
  color: #e2e8f0;
  background: #16213e;
}

.navbar-links a.active {
  color: #4ade80;
  background: #16213e;
}

.main-content {
  padding: 2rem;
  max-width: 1200px;
  margin: 0 auto;
}
