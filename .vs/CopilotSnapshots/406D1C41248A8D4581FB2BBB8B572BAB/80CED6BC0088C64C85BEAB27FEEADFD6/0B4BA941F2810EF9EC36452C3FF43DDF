.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.5rem;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.back-link {
  color: #64748b;
  text-decoration: none;
  font-size: 0.85rem;
  transition: color 0.2s;
}

.back-link:hover { color: #94a3b8; }

.info-card {
  background: #16213e;
  border: 1px solid #1e293b;
  border-radius: 10px;
  padding: 1.25rem 1.5rem;
  margin-bottom: 2rem;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.6rem 0;
  border-bottom: 1px solid #1e293b;
}

.info-row:last-child { border-bottom: none; }

.info-label {
  color: #475569;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  min-width: 120px;
}

.info-value { color: #94a3b8; font-size: 0.9rem; }

.info-link {
  color: #60a5fa;
  text-decoration: none;
  font-size: 0.9rem;
}

.info-link:hover { text-decoration: underline; }

.section-title {
  color: #cbd5e1;
  font-size: 1rem;
  font-weight: 600;
  margin: 0 0 1rem 0;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.stat-card {
  background: #16213e;
  border: 1px solid #1e293b;
  border-radius: 8px;
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.4rem;
}

.stat-period {
  color: #475569;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.stat-value {
  font-size: 1.6rem;
  font-weight: 700;
}

.metric-good { color: #4ade80; }
.metric-warn { color: #fbbf24; }
.metric-bad { color: #f87171; }

.response-card {
  background: #16213e;
  border: 1px solid #1e293b;
  border-radius: 8px;
  padding: 1rem 1.5rem;
  display: flex;
  align-items: center;
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.response-label {
  color: #475569;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.response-value {
  color: #60a5fa;
  font-size: 1.4rem;
  font-weight: 700;
}

.response-samples {
  color: #334155;
  font-size: 0.8rem;
}

.table-container {
  background: #16213e;
  border: 1px solid #1e293b;
  border-radius: 10px;
  overflow: hidden;
}

.table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.875rem;
}

.table thead { background: #0f172a; }

.table th {
  color: #64748b;
  text-align: left;
  padding: 0.75rem 1rem;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border-bottom: 1px solid #1e293b;
}

.table td {
  padding: 0.75rem 1rem;
  color: #94a3b8;
  border-bottom: 1px solid #1e293b;
}

.table tbody tr:last-child td { border-bottom: none; }

.row-unhealthy { background: rgba(248, 113, 113, 0.04); }

.error-cell {
  color: #f87171;
  font-size: 0.8rem;
  max-width: 200px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.status-badge {
  font-size: 0.7rem;
  font-weight: 700;
  padding: 0.15rem 0.55rem;
  border-radius: 10px;
}

.status-up { background: rgba(74, 222, 128, 0.15); color: #4ade80; }
.status-down { background: rgba(248, 113, 113, 0.15); color: #f87171; }
.status-unknown { background: rgba(100, 116, 139, 0.15); color: #94a3b8; }

.status-pill {
  font-size: 0.72rem;
  font-weight: 600;
  padding: 0.2rem 0.7rem;
  border-radius: 12px;
}

.pill-active { background: rgba(74, 222, 128, 0.15); color: #4ade80; }
.pill-inactive { background: rgba(100, 116, 139, 0.15); color: #94a3b8; }
