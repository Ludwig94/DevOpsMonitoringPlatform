.table-container {
  background: #16213e;
  border: 1px solid #1e293b;
  border-radius: 10px;
  overflow: hidden;
}

.table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
}

.table thead {
  background: #0f172a;
}

.table th {
  color: #64748b;
  text-align: left;
  padding: 0.85rem 1.1rem;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  font-weight: 600;
  border-bottom: 1px solid #1e293b;
}

.table td {
  padding: 0.9rem 1.1rem;
  color: #94a3b8;
  border-bottom: 1px solid #1e293b;
}

.table tbody tr:last-child td {
  border-bottom: none;
}

.table tbody tr:hover {
  background: #1e293b;
}

.target-link {
  color: #e2e8f0;
  text-decoration: none;
  font-weight: 500;
}

.target-link:hover {
  color: #4ade80;
}

.url-cell {
  max-width: 250px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.status-pill {
  font-size: 0.72rem;
  font-weight: 600;
  padding: 0.2rem 0.7rem;
  border-radius: 12px;
  letter-spacing: 0.4px;
}

.pill-active { background: rgba(74, 222, 128, 0.15); color: #4ade80; }
.pill-inactive { background: rgba(100, 116, 139, 0.15); color: #94a3b8; }

.actions-cell {
  display: flex;
  gap: 0.4rem;
  align-items: center;
}

.confirm-delete {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.confirm-text {
  color: #f87171;
  font-size: 0.8rem;
}
